#!/bin/bash

if [ -z "$FLANGDIR" ]; then export FLANGDIR=/opt/R/flang; fi

cmake \
      -DCMAKE_INSTALL_PREFIX=$FLANGDIR \
      -GNinja \
      -DCMAKE_Fortran_COMPILER=$FLANGDIR/bin/flang \
-DCMAKE_OSX_ARCHITECTURES='arm64' \
-DCMAKE_OSX_DEPLOYMENT_TARGET=$MACOSX_DEPLOYMENT_TARGET \
      -DLLVM_ENABLE_FATLTO=ON \
      -DLLVM_ENABLE_LTO=ON \
      -DFLANG_INCLUDE_TESTS=OFF \
      -DLLVM_INSTALL_TOOLCHAIN_ONLY=ON \
      -DLLVM_USE_SYMLINKS=ON \
      -DCMAKE_Fortran_COMPILER_WORKS=ON \
      -DFLANG_RT_ENABLE_SHARED=ON \
      -DFLANG_RT_ENABLE_STATIC=ON \
      -DFLANG_RT_INCLUDE_TESTS=OFF \
      -DLIBOMP_FORTRAN_MODULES_ONLY=ON \
      -DLLVM_ENABLE_RUNTIMES='flang-rt;openmp' \
      -DLLVM_INCLUDE_TESTS=OFF \
      -DOPENMP_ENABLE_OMPT_TOOLS=OFF \
      "$@"

#      -DRUNTIMES_OUTPUT_RESOURCE_MOD_DIR=$FLANGDIR/lib/clang/23/finclude/flang/arm64-apple-darwin25.2.0 \

