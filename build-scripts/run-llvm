#!/bin/bash

if [ -z "$FLANGDIR" ]; then export FLANGDIR=/opt/R/flang; fi

echo export SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX14.4.sdk
echo export MACOSX_DEPLOYMENT_TARGET=14.4
echo export PATH=$FLANGDIR/bin:'$PATH':/Applications/CMake.app/Contents/bin:'~/Library/Python/3.10/bin/'
echo
if [ -z "$SDKROOT" ]; then
echo Run the above before continuing
exit 1
fi

if [ -z "$1" ]; then
echo "   Usage: $0 <dir> [...]"
exit 1
fi

cmake \
-DCMAKE_INSTALL_PREFIX=$FLANGDIR \
-DLLVM_ENABLE_PROJECTS='clang;clang-tools-extra;mlir;polly' \
-DLLVM_ENABLE_RUNTIMES='compiler-rt;libcxx;libcxxabi;libunwind;openmp' \
-DCMAKE_OSX_ARCHITECTURES='arm64' \
-DCMAKE_OSX_DEPLOYMENT_TARGET=$MACOSX_DEPLOYMENT_TARGET \
-DFFI_INCLUDE_DIR=$SDKROOT/usr/include/ffi \
-DFFI_LIBRARY_DIR=$SDKROOT/usr/lib \
-DLLVM_POLLY_LINK_INTO_TOOLS=ON \
-DLLVM_BUILD_EXTERNAL_COMPILER_RT=ON \
-DLLVM_LINK_LLVM_DYLIB=ON \
-DLLVM_ENABLE_EH=OFF \
-DLLVM_ENABLE_FFI=ON \
-DLLVM_ENABLE_RTTI=ON \
-DLLVM_ENABLE_Z3_SOLVER=OFF \
-DLLVM_INCLUDE_BENCHMARKS=OFF \
-DLLVM_INCLUDE_DOCS=OFF \
-DLLVM_INCLUDE_TESTS=OFF \
-DLLVM_INSTALL_UTILS=ON \
-DLLVM_OPTIMIZED_TABLEGEN=ON \
-DLLVM_TARGETS_TO_BUILD=all \
-DLLVM_USE_RELATIVE_PATHS_IN_FILES=ON \
-DLIBOMP_INSTALL_ALIASES=OFF \
-DLIBCXX_INSTALL_MODULES=ON \
-DLLVM_CREATE_XCODE_TOOLCHAIN=OFF \
-DCLANG_FORCE_MATCHING_LIBCLANG_SOVERSION=OFF \
-DLLVM_BUILD_LLVM_C_DYLIB=ON \
-DLLVM_ENABLE_LIBCXX=ON \
-DLIBCXX_ENABLE_VENDOR_AVAILABILITY_ANNOTATIONS=ON \
-DLIBCXX_PSTL_BACKEND=libdispatch \
-DCMAKE_BUILD_TYPE=Release -G Ninja "$@"

#-DLLVM_SOURCE_PREFIX=. \
#-DCLANG_CONFIG_FILE_SYSTEM_DIR=../etc/clang \
#-DCLANG_CONFIG_FILE_USER_DIR=~/.config/clang \
